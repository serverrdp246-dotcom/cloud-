{
  "name": "Ubuntu 26.04 Android Studio Codespace (Fake Admin)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "ms-vscode.vscode-serial-monitor",
        "google-cloudtools.vscode-appengine"
      ]
    }
  },

  "portsAttributes": {
    "6080": {
      "label": "Desktop GUI (NoVNC)",
      "onAutoForward": "notify"
    }
  },

  "forwardPorts": [6080],

  // تشغيل سكريبت الإعداد عند إنشاء البيئة
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // تعيين الأدمن الوهمي كمستخدم افتراضي
  "remoteUser": "fakeadmin"
}
